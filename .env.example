# Copy this file to .env and fill in the values.
# .env is gitignored; never commit real credentials.

# Required for every request: the sw-access-key of the sales channel.
# Ask the shop operator for this value.
STROMBAUER_ACCESS_KEY=

# Optional: shop base URL. Default: https://shop.strombauer.com
STROMBAUER_BASE_URL=https://shop.strombauer.com

# --- Read-only E2E authentication -----------------------------------------
#
# Option A (strictly read-only): an existing sw-context-token. The E2E tests
# then perform only GET requests and never call login or logout.
#
# You can obtain a token with the CLI after logging in once; it is stored in
# ~/.config/strombauer/config.json as "contextToken".
STROMBAUER_CONTEXT_TOKEN=

# Option B: shop account credentials. The E2E tests log in, run the GET
# checks and log out again. Login and logout only create/destroy a session;
# they do not change shop data.
#
# Leave both empty when STROMBAUER_CONTEXT_TOKEN is set.
STROMBAUER_USERNAME=
STROMBAUER_PASSWORD=
